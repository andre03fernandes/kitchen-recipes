<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/KitchenRecipes.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/react/assets/index.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script type="module" src="~/react/assets/index.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
